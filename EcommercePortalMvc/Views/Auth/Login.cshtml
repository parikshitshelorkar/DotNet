@{
    ViewData["Title"] = "Login";
}
<h2>
    User Login
</h2>
<hr />

@if (ViewBag.Message != null)
{
    <p style="color:red;">@ViewBag.Message</p>
}
<form asp-action="Change Password" asp-controller="Account" method="post">
    <table>
        <tr>
            <td>
                <label for="">User Name</label>
                <td>
                    <input type="text" name="username" value="@Model.Name" placeholder="Enter Username " required />
                </td>
            </td>
        </tr>
        <tr>
            <td>
                <label for="">Password</label>
                <td>
                    <input type="password" name="Password" value="@Model.Password" placeholder="Enter Password" required />
                </td>
            </td>
        </tr>
        <tr>
            <td>
                <input type="checkbox"  id="rememberMe"     name="RememberMe" />
                <label for="rememberMe">Remember Me</label>
            </td>
        </tr>
        <tr>
            <td></td>
            <td>
                <input type="submit"  value="Login" />
            </td>
        </tr>
        <tr>
            <td colspan="2" align="center">
                <a asp-action="Login" asp-controller="Auth"> New User? Register Here  </a>
            </td>
        </tr>

    </table>

</form>