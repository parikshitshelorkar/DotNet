@{
    ViewData["Title"] = "Change Password";
}
<h2>
    Change Password
</h2>
<hr />

@if (ViewBag.Message != null)
{
    <p style="color:red;">@ViewBag.Message</p>
}
<form asp-action="Change Password" asp-controller="Auth" method="post">
    <table>
        <tr>
            <td>
                <label for="">Current Password</label>
                <td>
                    <input type="password" name="currentPassword" placeholder="Enter Current Password" required />
                </td>
            </td>
        </tr>
        <tr>
            <td>
                <label for="">New Password</label>
                <td>
                    <input type="password" name="newPassword" placeholder="New Password" required />
                </td>
            </td>
        </tr>
        <tr>
            <td>
                <label for="">Confirm Password</label>
                <td>
                    <input type="password" name="confirmPassword" placeholder="Confirm Password" required />
                </td>
            </td>
        </tr>
        <tr>
            <td></td>
            <td>
                <input type="submit"  value="Change Password" />
            </td>
        </tr>
        <tr>
            <td colspan="2" align="center">
                <a asp-action="Login" asp-controller="Auth"> Back to Login  </a>
            </td>
        </tr>

    </table>

</form>