@model ECommercePortalMvc.Models.Product
@{
    ViewData["Title"] = "Update Product";
}

<h2>Update Product</h2>
<form asp-action="Update" method="post">
<input type="hidden" name="Id" value="@Model.Id"/>
<table cellpadding="8">
    <tr>
        <td>Id</td>
        <td>@Model.Id</td>
    </tr>
    <tr>
        <td>Name</td>
        <td>
            <input type="text"  name="Name" value="@Model.Name"   required />
        </td>
    </tr>
    <tr>
        <td>Price</td>
        <td>
            <input type="number"  step="0.01" name="Price" value="@Model.Price"   required />
        </td>
    </tr>
    <tr>
        <td></td>
        <td>
            <input type="submit"    value="Update"/>
        </td>
    </tr>
</table>
</form>
<br/>
<a asp-action="List">Back</a>