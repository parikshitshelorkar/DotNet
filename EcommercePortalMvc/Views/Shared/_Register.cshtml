@model ECommercePortalMvc.Models.Customer

<h2>
    Register User
</h2>
<hr />

@if (ViewBag.Message != null)
{
    <p style="color:red;">@ViewBag.Message</p>
}
<form asp-action="Register" asp-controller="Auth" method="post">
    <table>
        <tr>
            <td>
                <label for="">User Name</label>
                <td>
                    <input type="text" name="Name" value="@Model.Name" placeholder="Enter Username " required />
                </td>
            </td>
        </tr>
        <tr>
            <td>
                <label for="">Email</label>
                <td>
                    <input type="password" name="Email" value="@Model.Email" placeholder="Enter Email" required />
                </td>
            </td>
        </tr>
        <tr>
            <td>
                <label>Mobile Number</label>

            </td>
            <td>
                <input type="tel" name="contact" value="@Model.Contact" placeholder="Enter Mobile Number" required />
            </td>
        </tr>
        <tr>
            <td><label>Password</label></td>
            <td>
                <input type="password" name="Password" value="@Model.Password" placeholder="Enter Password" required />
            </td>
        </tr>

        <tr>
            <td><label>Confirm Password</label></td>
            <td>
                <input type="password" name="ConfirmPassword" value="@Model.ConfirmPassword"
                       placeholder="Confirm Password" required />
            </td>
        </tr>
        <tr>
            <td></td>
            <td>
                <input type="checkbox" id="acceptTerms" name="AcceptTerms" required />
                <label for="acceptTerms"> I accept the Terms and Conditions </label>
            </td>
        </tr>
        <tr>
            <td></td>
            <td>
                <input type="submit" value="Register" />
            </td>
        </tr>
        <tr>
            <td colspan="2" align="center">
                Already have an account?
                <a asp-action="Index" asp-controller="Auth"> Login </a>

            </td>
        </tr>

    </table>

</form>